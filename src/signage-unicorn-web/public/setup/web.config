<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <security>
            <requestFiltering>
                <fileExtensions>
                     <remove fileExtension=".exe" />
                     <add fileExtension=".exe" allowed="true" />
                </fileExtensions>
            </requestFiltering>
        </security>
        <staticContent>
            <remove fileExtension=".exe" />
            <mimeMap fileExtension=".exe" mimeType="application/vnd.microsoft.portable-executable" />
        </staticContent>
    </system.webServer>
</configuration>
